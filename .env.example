# Copy to `.env` and set your production origin.
#
# astro.config.mjs resolves the site URL in this order:
#   1. PUBLIC_SITE_URL
#   2. SITE_URL
#   3. built-in placeholder (https://tlddirectory.com)
#
# The value must be an absolute http(s) URL with a dotted hostname.
# It drives canonical tags, sitemap-index.xml, robots.txt and all Open Graph URLs.
#
# Leave empty to build with the placeholder origin (local development only).

PUBLIC_SITE_URL=

