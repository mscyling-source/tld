---
// Layout.astro — base HTML document with header, footer, and skip link.
import '../styles/global.css';
import { siteConfig, navLinks, footerLinks } from '../config/site.js';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  /**
   * schema.org structured data for this page (one object or a list).
   *
   * Emitted as `application/ld+json`. Callers are responsible for only
   * describing facts the page actually shows — a `Dataset` block must carry
   * the real dataset date, never a build time.
   */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, canonical, noindex, ogImage, jsonLd } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const fullCanonical = canonical ? new URL(canonical, Astro.site).toString() : url.toString();
const fullOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : new URL('/og-default.png', Astro.site).toString();
const jsonLdBlocks = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang={siteConfig.language}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <title>{title} — {siteConfig.name}</title>
  <meta name="description" content={description || siteConfig.description} />

  <link rel="canonical" href={fullCanonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description || siteConfig.description} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:site_name" content={siteConfig.name} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description || siteConfig.description} />
  <meta name="twitter:image" content={fullOgImage} />

  <link rel="sitemap" href="/sitemap-index.xml" />

  {jsonLdBlocks.map(block => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(block).replace(/</g, '\\u003c')}
    />
  ))}
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="border-b border-ink-200 bg-white sticky top-0 z-40" role="banner">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-brand-700 font-semibold text-xl" aria-label={siteConfig.name}>
          <span class="text-ink-900 font-bold">{siteConfig.shortName}</span>
          <span class="hidden sm:inline">{siteConfig.name}</span>
        </a>

        <nav class="hidden md:flex items-center gap-6" role="navigation" aria-label="Main navigation">
          {navLinks.map(link => (
            <a href={link.href} class="text-sm font-medium text-ink-700 hover:text-brand-600 transition-colors">{link.label}</a>
          ))}
        </nav>

        <button class="md:hidden p-2 rounded-lg text-ink-600 hover:bg-ink-100" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="md:hidden hidden border-t border-ink-200 bg-white" role="navigation" aria-label="Mobile navigation">
      <div class="px-4 py-3 space-y-2">
        {navLinks.map(link => (
          <a href={link.href} class="block px-3 py-2 text-base font-medium text-ink-700 hover:text-brand-600 hover:bg-ink-50 rounded-lg">{link.label}</a>
        ))}
      </div>
    </div>
  </header>

  <main id="main-content" class="flex-1" role="main">
    <slot />
  </main>

  <footer class="border-t border-ink-200 bg-ink-50" role="contentinfo">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-4">
        {footerLinks.map(group => (
          <section aria-labelledby={group.title.toLowerCase().replace(/\s+/g, '-')}>
            <h2 id={group.title.toLowerCase().replace(/\s+/g, '-')} class="text-sm font-semibold text-ink-900 uppercase tracking-wider">{group.title}</h2>
            <ul class="mt-3 space-y-2" role="list">
              {group.items.map(item => (
                <li><a href={item.href} class="text-sm text-ink-600 hover:text-brand-600">{item.label}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="mt-10 pt-8 border-t border-ink-200">
        <p class="text-sm text-ink-500 text-center">
          &copy; {siteConfig.foundedYear} {siteConfig.name}. Data sourced from <a href="https://www.iana.org/domains/root/db" class="underline hover:text-brand-600">IANA Root Zone Database</a>.
          Not affiliated with ICANN or any registry. <a href="/privacy/" class="underline hover:text-brand-600">Privacy</a> · <a href="/terms/" class="underline hover:text-brand-600">Terms</a>
        </p>
      </div>
    </div>
  </footer>

  <script is:inline>
    const menuBtn = document.querySelector('header button[aria-controls="mobile-menu"]');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!expanded));
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>