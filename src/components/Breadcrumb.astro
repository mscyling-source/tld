---
// Breadcrumb.astro — structured breadcrumb navigation with schema.org markup.
interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;
---

<nav class="mb-6" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
  <ol class="flex flex-wrap items-center gap-2 text-sm" role="list">
    {items.map((item, i) => (
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} itemprop="item" class="text-ink-500 hover:text-brand-600 transition-colors">
            <span itemprop="name">{item.label}</span>
          </a>
        ) : (
          <span itemprop="name" class="text-ink-900 font-medium" aria-current="page">{item.label}</span>
        )}
        <meta itemprop="position" content={i + 1} />
        {i < items.length - 1 && <span class="text-ink-300" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>