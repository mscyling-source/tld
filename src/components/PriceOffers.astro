---
// PriceOffers.astro — per-TLD registrar price comparison on detail pages.
//
// Every figure is a stored source quote with its own evidence date. The two
// provenance questions are answered separately and visibly:
//   - how the price was obtained  (verified / snapshot / modelled)
//   - how old that evidence is    (recent / aging / stale / unknown)
// A missing value renders as "—" with an explanation, never as 0, and a price
// whose evidence is older than the stale threshold is never presented as a
// current quote without saying so.
import type { PriceOffer } from '../lib/pricingTypes.js';
import {
  cheapestPoint,
  effectiveFreshness,
  formatDate,
  formatUsd,
  isPromotionExpired,
} from '../lib/pricingCalc.js';
import {
  FRESHNESS_EXPLANATION,
  FRESHNESS_LABEL,
  VERIFICATION_EXPLANATION,
  VERIFICATION_LABEL,
} from '../config/freshness.js';
import { outboundRel, hasAffiliate } from '../config/registrars.js';

interface Props {
  suffix: string;
  offers: PriceOffer[];
}

const { suffix, offers } = Astro.props;
const now = new Date();

const fresh = offers.map(o => ({
  ...o,
  freshness: effectiveFreshness(o, now),
}));
const minRegister = cheapestPoint(fresh, 'register_usd', now);
const minRenewal = cheapestPoint(fresh, 'renewal_usd', now);
const minThreeYear = cheapestPoint(fresh, 'three_year_usd', now);

const sorted = [...fresh].sort((a, b) => {
  const ar = a.register_usd ?? Infinity;
  const br = b.register_usd ?? Infinity;
  if (ar !== br) return ar - br;
  return a.registrar_name.localeCompare(b.registrar_name, 'en');
});

const dates = fresh.map(o => o.last_checked).filter(d => typeof d === 'string' && d !== '');
const latest = dates.length
  ? dates.reduce((max, d) => (Date.parse(d) > Date.parse(max) ? d : max))
  : '';
const latestLabel = latest
  ? new Date(latest).toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })
  : null;

// A "cheapest" badge must never imply a current quote when the winning row is
// only a snapshot, is stale, or has no usable date — the badge is suppressed
// and the row's own provenance badges carry the caveat.
const cheapestIsCurrent = (point: typeof minRegister): boolean =>
  point !== null &&
  point.verification_status === 'verified' &&
  point.freshness !== 'stale' &&
  point.freshness !== 'unknown';

const anyVerified = fresh.some(o => o.verification_status === 'verified');
// Fields where every published quote is older than the stale threshold (or
// undated): the table can still show the figures, but it must say that current
// evidence is missing instead of letting an old number stand in for a quote.
const noCurrentEvidence = [
  minRegister?.no_current_evidence ? 'registration' : null,
  minRenewal?.no_current_evidence ? 'renewal' : null,
  minThreeYear?.no_current_evidence ? '3-year cost' : null,
].filter((f): f is string => f !== null);
const anyAffiliate = fresh.some(o => hasAffiliate(o.registrar_id));
const fmt = (v: number | null) => (v === null ? null : formatUsd(v));

const badgeClass: Record<string, string> = {
  recent: 'bg-emerald-100 text-emerald-800',
  aging: 'bg-amber-100 text-amber-800',
  stale: 'bg-rose-100 text-rose-800',
  unknown: 'bg-ink-200 text-ink-700',
};
const verificationBadgeClass: Record<string, string> = {
  verified: 'bg-sky-100 text-sky-800',
  source_snapshot: 'bg-violet-100 text-violet-800',
  model_derived: 'bg-amber-100 text-amber-800',
  unverified: 'bg-ink-200 text-ink-700',
};
---

{fresh.length === 0 ? (
  <section class="mt-8 rounded-xl border border-ink-200 bg-white p-5" aria-labelledby="no-prices-heading">
    <h2 id="no-prices-heading" class="text-lg font-semibold text-ink-900">Registrar prices for {suffix}</h2>
    <p class="mt-2 text-sm text-ink-600">
      No price data for {suffix} yet. We only show prices sourced from published registrar
      price lists — never estimates. Check the official sources below, or revisit later: price data
      updates on a schedule. <a href="/data-sources/" class="text-brand-600 hover:underline">How our price data works →</a>
    </p>
  </section>
) : (
  <section class="mt-8 rounded-xl border border-ink-200 bg-white p-5" aria-labelledby="price-heading">
    <header class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
      <h2 id="price-heading" class="text-lg font-semibold text-ink-900">
        Where to register {suffix} — price comparison
      </h2>
      <p class="text-xs text-ink-500">
        All prices in USD
        {latestLabel && <> · newest price evidence <time datetime={latest}>{latestLabel}</time></>}
      </p>
    </header>

    {!anyVerified && (
      <p class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
        <strong>No price below was read from a registrar’s own price list.</strong>
        These figures come from openly licensed dated snapshots, so they reflect what their
        sources recorded on the date shown — not necessarily today’s price. Confirm at the
        registrar before buying.
      </p>
    )}

    {noCurrentEvidence.length > 0 && (
      <p class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-900">
        <strong>No current {noCurrentEvidence.join(' or ')} quote.</strong>
        Every figure we hold for that field is more than 30 days old or undated, so the values
        shown are historical references rather than today’s price. That is a gap in our data,
        not a claim that the figure is current. Confirm at the registrar before buying.
      </p>
    )}

    <p class="mb-2 text-xs text-ink-500 sm:hidden">
      Swipe the table sideways to see transfer, 3-year and evidence columns.
    </p>

    <div class="overflow-x-auto">
      <table class="min-w-[720px] w-full text-sm">        <thead class="bg-ink-50 text-left">
          <tr>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">Registrar</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">Register<span class="block text-xs font-normal text-ink-500">first year</span></th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">Renew<span class="block text-xs font-normal text-ink-500">per year</span></th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">Transfer</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">3-year cost</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">Promotion</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink-700">Price evidence<span class="block text-xs font-normal text-ink-500">how obtained &amp; when</span></th>
            <th scope="col" class="px-3 py-2.5"><span class="sr-only">Buy</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          {sorted.map(o => {
            const evidenceDate = o.price_verified_at ?? o.price_observed_at ?? null;
            const checked = formatDate(evidenceDate);
            const evidenceKind = o.price_verified_at ? 'verified' : 'observed';
            const promoExpired = isPromotionExpired(o.promotion_expires_at, now);
            const cheapestRegister =
              minRegister?.registrar_id === o.registrar_id && cheapestIsCurrent(minRegister);
            const cheapestRenewal =
              minRenewal?.registrar_id === o.registrar_id && cheapestIsCurrent(minRenewal);
            const bestValue =
              minThreeYear?.registrar_id === o.registrar_id && cheapestIsCurrent(minThreeYear);
            const showPromo = o.promotional && !promoExpired;
            return (
              <tr>
                <td class="px-3 py-3 font-medium text-ink-900">
                  {o.registrar_name}
                  <span
                    class={`ml-1 align-middle px-1.5 py-0.5 text-[10px] font-medium rounded ${verificationBadgeClass[o.verification_status]}`}
                    title={VERIFICATION_EXPLANATION[o.verification_status]}
                  >{VERIFICATION_LABEL[o.verification_status]}</span>
                  <span
                    class={`ml-1 align-middle px-1.5 py-0.5 text-[10px] font-medium rounded ${badgeClass[o.freshness]}`}
                    title={FRESHNESS_EXPLANATION[o.freshness]}
                  >{FRESHNESS_LABEL[o.freshness]}</span>
                </td>
                <td class="px-3 py-3">
                  {fmt(o.register_usd) ? (
                    <span class="font-semibold text-ink-900">{fmt(o.register_usd)}</span>
                  ) : (
                    <span class="text-ink-400" title="This source does not publish a registration price">—</span>
                  )}
                  {cheapestRegister && <span class="ml-1.5 align-middle px-1.5 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 rounded" title="Lowest first-year price among quotes whose evidence is current (≤30 days). A cheaper quote with older evidence is listed in its own row with a stale badge.">cheapest</span>}
                  {showPromo && <span class="ml-1.5 align-middle px-1.5 py-0.5 text-[10px] font-medium bg-sky-100 text-sky-800 rounded" title="Source flags this as a promotional first-year price">promo</span>}
                  {promoExpired && <span class="ml-1.5 align-middle px-1.5 py-0.5 text-[10px] font-medium bg-ink-200 text-ink-700 rounded" title="The published promotion end date has passed">promo ended</span>}
                </td>
                <td class="px-3 py-3">
                  {fmt(o.renewal_usd) ? (
                    <span class="font-semibold text-ink-900">{fmt(o.renewal_usd)}</span>
                  ) : (
                    <span class="text-ink-400" title="This source does not publish a renewal price">—</span>
                  )}
                  {cheapestRenewal && <span class="ml-1.5 align-middle px-1.5 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 rounded" title="Lowest renewal price among quotes whose evidence is current (≤30 days). A cheaper quote with older evidence is listed in its own row with a stale badge.">cheapest</span>}
                </td>
                <td class="px-3 py-3">
                  {fmt(o.transfer_usd) ?? <span class="text-ink-400" title="This source does not publish a transfer price">—</span>}
                </td>
                <td class="px-3 py-3">
                  {fmt(o.three_year_usd) ? (
                    <>
                      <span class="font-semibold text-ink-900">{fmt(o.three_year_usd)}</span>
                      {bestValue && <span class="ml-1.5 align-middle px-1.5 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 rounded" title="Lowest 3-year cost among quotes whose evidence is current (≤30 days).">best value</span>}
                    </>
                  ) : (
                    <span class="text-ink-400" title="Needs both registration and renewal prices">—</span>
                  )}
                </td>
                <td class="px-3 py-3 text-xs text-ink-600">
                  {promoExpired ? (
                    <span class="text-ink-500">Promotion ended {formatDate(o.promotion_expires_at)}</span>
                  ) : o.promo_code ? (
                    <>
                      <code class="px-1 py-0.5 bg-ink-100 rounded">{o.promo_code}</code>
                      {o.promo_restrictions && <span class="block mt-0.5">{o.promo_restrictions}</span>}
                    </>
                  ) : showPromo ? (
                    <span>Promotional first-year price — conditions may apply at the registrar</span>
                  ) : (
                    <span class="text-ink-400">—</span>
                  )}
                </td>
                <td class="px-3 py-3 text-xs text-ink-500">
                  <a
                    href={o.source_url}
                    target="_blank"
                    rel="noopener"
                    title={`Price source: ${o.source_name} — ${VERIFICATION_EXPLANATION[o.verification_status]}`}
                    class="underline decoration-dotted hover:text-brand-600"
                  >{checked ?? 'no date'}<span class="block text-[10px] text-ink-400">{evidenceKind}</span></a>
                </td>
                <td class="px-3 py-3 text-right">
                  {o.purchase_url && (
                    <a
                      href={o.purchase_url}
                      rel={outboundRel(o.registrar_id)}
                      target="_blank"
                      class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium text-brand-700 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100"
                    >
                      Visit {o.registrar_name}
                    </a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <footer class="mt-4 space-y-2 text-xs text-ink-500">
      <p>
        <strong>Price evidence</strong> is not the same as “checked today”. A
        <span class="mx-1 px-1 rounded bg-sky-100 text-sky-800">{VERIFICATION_LABEL.verified}</span>
        badge means we read the figure from that registrar’s own published price list; the date shown
        is when we read it. A
        <span class="mx-1 px-1 rounded bg-violet-100 text-violet-800">{VERIFICATION_LABEL.source_snapshot}</span>
        badge means the figure comes from an openly licensed dated dataset and the date shown is that
        dataset’s observation date — the registrar may have changed price since.
        <span class="mx-1 px-1 rounded bg-amber-100 text-amber-800">{FRESHNESS_LABEL.stale}</span>
        means the evidence is older than 30 days and should be treated as a historical reference,
        not a quote. Only rows we verified from the registrar itself can be labelled “cheapest”.
      </p>
      <p>
        3-year cost = first-year registration + 2 × standard renewal at the same registrar; shown only
        when the source publishes both prices. A low first-year promotional price can still renew high —
        compare the renewal column for the long-term picture. Standard list prices are shown; premium
        domain names and registry eligibility rules can change the final amount.
      </p>
      <p>
        {anyAffiliate
          ? 'Some registrar links may be affiliate links — affiliate relationships never affect price rankings. '
          : 'Links to registrars are ordinary links with no tracking parameters; price rankings depend only on published prices. '}
        Sources: <a href="/data-sources/" class="underline hover:text-brand-600">price data sources &amp; licences</a>.
        Verify the current price at the registrar before purchasing.
      </p>
    </footer>
  </section>
)}