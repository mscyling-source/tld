---
// Hero.astro — compact homepage hero. The price comparison table is the
// main event, so the hero stays tight and hands off to it directly.
import { siteConfig } from '../config/site.js';
---

<section class="py-10 sm:py-12 bg-gradient-to-b from-brand-50 to-white" aria-labelledby="hero-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 id="hero-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-ink-900 tracking-tight">
        Find the Cheapest Place to Register Any Domain
      </h1>
      <p class="mt-4 text-base sm:text-lg text-ink-600 max-w-2xl mx-auto">
        {siteConfig.description}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#compare"
          class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-white bg-brand-600 rounded-lg shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500"
        >
          Compare prices ↓
        </a>
        <a
          href="/tlds/"
          class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-ink-700 bg-white border border-ink-300 rounded-lg shadow-sm hover:bg-ink-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500"
        >
          Browse all TLDs
        </a>
      </div>
    </div>
  </div>
</section>
