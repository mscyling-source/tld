---
// 404.astro
import Layout from '../components/Layout.astro';
import { loadAllRecords } from '../lib/store.js';

const records = await loadAllRecords();
const randomRecords = [...records].sort(() => 0.5 - Math.random()).slice(0, 5);
---

<Layout title="Page Not Found — TLD Directory" description="The page you're looking for doesn't exist. Try searching for a TLD or browsing the directory." noindex={true}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h1 class="text-6xl font-bold text-ink-200">404</h1>
    <h2 class="mt-4 text-2xl font-semibold text-ink-900">Page not found</h2>
    <p class="mt-3 text-ink-600 max-w-xl mx-auto">The page you're looking for doesn't exist or has been moved.</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/tlds/" class="px-5 py-2.5 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700">Browse all TLDs</a>
      <a href="/" class="px-5 py-2.5 text-sm font-medium text-brand-600 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100">Go home</a>
    </div>

    <form action="/tlds/" method="get" class="mt-8 max-w-md mx-auto" role="search">
      <label for="search-404" class="sr-only">Search TLDs</label>
      <div class="flex gap-2">
        <input id="search-404" name="q" type="search" placeholder="Search for a TLD…" class="flex-1 px-4 py-2.5 text-sm border border-ink-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
        <button type="submit" class="px-4 py-2.5 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700">Search</button>
      </div>
    </form>

    <section class="mt-12 text-left" aria-labelledby="suggestions-heading">
      <h3 id="suggestions-heading" class="text-lg font-semibold text-ink-900 mb-4 text-center">Popular TLDs</h3>
      <div class="flex flex-wrap justify-center gap-2">
        {randomRecords.map(r => (
          <a href={`/tld/${r.ascii_name}/`} class="px-3 py-1.5 text-sm font-mono bg-ink-100 text-ink-700 rounded-lg hover:bg-brand-100 hover:text-brand-600 transition">{r.suffix}</a>
        ))}
      </div>
    </section>
  </div>
</Layout>