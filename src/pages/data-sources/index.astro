---
// data-sources/index.astro
import Layout from '../../components/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { siteConfig } from '../../config/site.js';
import { getPriceStats } from '../../lib/pricing.js';

// Read live: this page's whole job is to say how current the data actually is,
// so it must not describe the pipeline in the abstract.
const stats = await getPriceStats();

const utcDay = (value: string | null): string => {
  if (!value) return '—';
  const t = Date.parse(value);
  if (Number.isNaN(t)) return '—';
  return new Date(t).toISOString().slice(0, 10);
};

const evidenceStateLabel: Record<string, string> = {
  current: 'Current',
  aging: 'Not recent',
  frozen: 'Frozen upstream',
  none: 'No dated data',
};

const daysSince = (value: string | null): number | null => {
  if (!value) return null;
  const t = Date.parse(value);
  if (Number.isNaN(t)) return null;
  return Math.max(0, Math.round((Date.now() - t) / 86_400_000));
};
---

<Layout
  title="Data Sources"
  description="Transparent documentation of the data sources, update process, and verification methods behind TLD Directory."
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Data Sources' }
    ]} />

    <article class="prose prose-ink max-w-none">
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-ink-900">Data Sources & Methodology</h1>
        <p class="mt-3 text-ink-600 text-lg">Where our data comes from, how it's verified, and how often it's updated.</p>
      </header>

      <section>
        <h2>Primary sources</h2>
        <dl>
          <dt><strong>IANA Root Zone Database</strong></dt>
          <dd><a href="https://www.iana.org/domains/root/db" target="_blank" rel="noopener">https://www.iana.org/domains/root/db</a> — The authoritative table of all delegated TLDs, their types, and sponsoring organisations. Updated by IANA as delegations change.</dd>

          <dt><strong>IANA Delegated TLD List</strong></dt>
          <dd><a href="https://data.iana.org/TLD/tlds-alpha-by-domain.txt" target="_blank" rel="noopener">https://data.iana.org/TLD/tlds-alpha-by-domain.txt</a> — Plain-text list of all currently delegated TLD labels. Includes a version header with date. Updated weekly.</dd>

          <dt><strong>IANA Per-TLD Delegation Records</strong></dt>
          <dd><code>https://www.iana.org/domains/root/db/&#123;tld&#125;.html</code> — Individual pages for each TLD with registry information (WHOIS, RDAP, registration services URL), delegation history, and reference documents.</dd>
        </dl>
      </section>

      <section>
        <h2>Registrar pricing sources</h2>
        <p>
          Price comparison data is kept fully separate from IANA metadata
          (<code>data/tlds.json</code> vs <code>data/prices.json</code>). Every price figure below is
          published by the source itself — we never estimate, convert, or invent prices. Sources
          without a value are shown as "Price unavailable".
        </p>

        <h3>First-party reads — labelled <em>Verified</em></h3>
        <p>
          These sources are the registrars' own published price lists, read directly by our daily
          sync. A price from here is stamped with the moment we read it, and that timestamp is the
          only thing that can make a price "recently verified".
        </p>
        <dl>
          <dt><strong>Porkbun API</strong> — official, no authentication</dt>
          <dd>
            <a href="https://porkbun.com/api/json/v3/documentation" target="_blank" rel="noopener">Porkbun API v3 — pricing endpoint</a> —
            registration, renewal and transfer list prices in USD for every TLD Porkbun sells.
            Documented as a public endpoint by Porkbun; fetched daily.
          </dd>

          <dt><strong>Dynadot price list</strong></dt>
          <dd>
            <a href="https://www.dynadot.com/domain/prices" target="_blank" rel="noopener">dynadot.com/domain/prices</a> —
            Dynadot's published catalogue, read from the server-rendered page payload. A struck
            original price is treated as a promotion, exactly as the page presents it.
          </dd>

          <dt><strong>Gandi price list</strong></dt>
          <dd>
            <a href="https://www.gandi.net/en-US/domain/tld" target="_blank" rel="noopener">gandi.net/domain/tld</a> —
            the official per-extension price table (creation, transfer, renewal). Fetched one letter
            prefix at a time with a delay between requests; Gandi's robots.txt allows these pages.
          </dd>

          <dt><strong>Hover price list</strong></dt>
          <dd>
            <a href="https://www.hover.com/domain-pricing" target="_blank" rel="noopener">hover.com/domain-pricing</a> —
            the published registration, renewal and transfer prices carried in the page's own data
            payload.
          </dd>

          <dt><strong>IONOS price list</strong></dt>
          <dd>
            <a href="https://www.ionos.com/domains/domain-name-prices" target="_blank" rel="noopener">ionos.com/domains/domain-name-prices</a> —
            first-year welcome price, existing-customer price, standard renewal fee and transfer fee.
            IONOS's bundle price is never used, because it is not a single-domain price.
          </dd>
        </dl>

        <h3>Openly licensed datasets — labelled <em>Snapshot</em></h3>
        <p>
          These are third-party datasets. They are downloaded fresh every day, but the dates inside
          them are the dataset's <em>own</em> observation dates, which can be weeks old. They are
          never labelled "verified", however recently we downloaded them.
        </p>
        <dl>
          <dt><strong>Best Domain Registrars</strong> — licence: CC BY 4.0</dt>
          <dd>
            <a href="https://www.best-domain-registrars.com/data" target="_blank" rel="noopener">best-domain-registrars.com/data</a> —
            per-registrar price table plus a verification taxonomy that distinguishes figures the
            publisher verified, figures confirmed against a pricing model, and placeholder samples.
            We reuse that taxonomy rather than flattening it: rows marked as samples (currently
            Squarespace) are dropped, and model-confirmed rows are classified <em>Modelled</em> —
            but they only win when no better-evidenced copy exists for the same registrar and
            extension. Cloudflare, for example, is currently covered by a dated snapshot that
            outranks the model row, so no <em>Modelled</em> rows are published today. Rows the
            publisher verified stay <em>Snapshot</em> here, because that attestation is theirs — not
            a read we performed. Attribution:
            <em>"Price data by Best Domain Registrars"</em>.
          </dd>

          <dt><strong>Pikkly open data</strong> — licence: CC BY 4.0</dt>
          <dd>
            <a href="https://pikkly.dev/data" target="_blank" rel="noopener">pikkly.dev/data</a> —
            daily-rebuilt JSON covering 6 registrars. Rows sourced from dated community dumps use the
            dump date as their observation date, not the rebuild time. Attribution:
            <em>"Price data by Pikkly"</em>.
          </dd>

          <dt><strong>Open Domain Data — tld_pricing</strong> — licence: CC BY 4.0</dt>
          <dd>
            <a href="https://www.opendomaindata.org/datasets/tld-pricing" target="_blank" rel="noopener">opendomaindata.org</a> —
            monthly snapshot of register/renew/transfer prices normalised to USD across 7 registrars.
            Citation: <em>Open Domain Data (2026). tld_pricing, opendomaindata.org</em>. Records carry
            their own check dates, which can be weeks old — anything past 30 days is labelled
            "stale".
          </dd>
        </dl>

        <h3>Why some registrars have no first-party price</h3>
        <p>
          A registrar appears as <em>Snapshot</em> only when we could not read its own price list.
          The reasons are concrete, not a lack of effort:
        </p>
        <ul>
          <li>
            <strong>Cloudflare Registrar</strong> sells at cost and publishes no static per-TLD
            price list. Its prices only appear through an interactive search tool rendered in the
            browser, and the JSON endpoint that feeds that tool answers a plain server-side request
            with an HTTP 403 bot challenge. There is therefore no page we may legally read, so its
            figures can only come from a licensed dataset.
          </li>
          <li>
            <strong>Namecheap</strong> and <strong>Spaceship</strong> answer a plain server-side
            request with HTTP 403 (bot protection). Reading them would mean executing JavaScript or
            evading the challenge, which this project does not do. Their official APIs require an
            account: Namecheap's additionally needs an API key bound to an allow-listed IP.
          </li>
          <li>
            <strong>GoDaddy</strong> publishes no machine-readable price list either; its figures come
            from the Best Domain Registrars dataset, which is why they are labelled
            <em>Snapshot</em> even when they are only days old.
          </li>
        </ul>
        <p>
          Those rows keep their honest date and are never promoted to <em>Verified</em>. They also
          never win the "cheapest" slot on a comparison table while a current quote exists — when a
          stale quote is cheaper, the table lists it underneath the ranked price with a ↓ marker, so
          an older lower price is disclosed rather than hidden.
        </p>

        <h3>Placeholder pricing we refuse to dress up</h3>
        <p>
          Squarespace Domains appears in both open datasets, but Best Domain Registrars marks its
          figures as <code>sample</code> — the publisher's own read of Squarespace's pricing was
          blocked, so those numbers are placeholders. Open Domain Data repeats the same figures
          without that warning. We keep the rows so you can see the registrar exists, but they are
          published as <strong>Unverified</strong>: no verification date, no freshness band, and they
          can never be labelled "cheapest". The same rule applies to any registrar added to
          <code>UNTRUSTED_REGISTRAR_PRICES</code>.
        </p>

        <h3>How a price is dated</h3>
        <p>
          The old dataset collapsed three different questions into one date, which is why prices
          looked fresher than they were. Each offer now carries three separate timestamps:
        </p>
        <table>
          <thead><tr><th>Field</th><th>Question it answers</th></tr></thead>
          <tbody>
            <tr><td><code>source_fetched_at</code></td><td>When did <em>we</em> download this source? Says nothing about how old the numbers are.</td></tr>
            <tr><td><code>price_observed_at</code></td><td>When does the <em>source</em> say it observed this price?</td></tr>
            <tr><td><code>price_verified_at</code></td><td>When did <em>we</em> read this figure from the registrar itself? Empty for snapshots.</td></tr>
          </tbody>
        </table>
        <p>
          The date shown next to a price is always the evidence date — the verification date for a
          first-party read, otherwise the source's own observation date — never the download date.
        </p>

        <h3>Is the data current right now?</h3>
        <p>
          A successful workflow is not the same thing as a refreshed price. Each source therefore
          reports three separate timestamps — when we last <em>attempted</em> it, when it last
          <em>succeeded</em>, and the newest <em>price evidence</em> it actually carries — plus
          whether this run obtained anything newer than the previous one.
        </p>
        {stats?.coverage && (
          <p>
            <strong>Coverage: {stats.coverage.complete ? 'complete' : 'incomplete'}.</strong>{' '}
            {stats.coverage.note}
          </p>
        )}
        {stats && (
          <table>
            <thead>
              <tr>
                <th>Source</th>
                <th>How read</th>
                <th>Last successful fetch (UTC)</th>
                <th>Newest price evidence</th>
                <th>Oldest price evidence</th>
                <th>New evidence this run</th>
                <th>Published rows</th>
                <th>State</th>
              </tr>
            </thead>
            <tbody>
              {stats.sources.map(s => (
                <tr>
                  <td>{s.name}</td>
                  <td>{s.verification_status === 'verified' ? 'First-party' : 'Snapshot'}</td>
                  <td>{utcDay(s.last_successful_fetch_at)}</td>
                  <td>
                    {utcDay(s.price_evidence_at)}
                    {daysSince(s.price_evidence_at) !== null ? ` (${daysSince(s.price_evidence_at)}d)` : ''}
                  </td>
                  <td>{utcDay(s.oldest_observed_at)}</td>
                  <td>{s.evidence_advanced ? 'Yes' : 'No'}</td>
                  <td>{s.published_rows}</td>
                  <td>{evidenceStateLabel[s.evidence_state] ?? s.evidence_state}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        {stats && stats.sources.some(s => s.evidence_state === 'frozen') && (
          <p>
            <strong>Frozen upstream snapshots.</strong> A source can be downloaded perfectly every
            day and still contain nothing new: its own observation dates do not move. The sources
            marked <em>Frozen upstream</em> above are exactly that — the fetch succeeds, the file is
            re-downloaded, and the prices inside it are unchanged because the publisher has not
            re-read the registrar. Those rows are labelled <em>Stale</em> everywhere on the site and
            can never take a “cheapest” slot.
          </p>
        )}
        {stats?.coverage && stats.coverage.registrars_without_current_evidence.length > 0 && (
          <p>
            <strong>No current quote.</strong> For{' '}
            {stats.coverage.registrars_without_current_evidence.join(', ')} every published figure is
            older than the stale threshold, so their prices are shown as historical references and
            are excluded from cheapest-price ranking.
          </p>
        )}

        <h3>Verification and freshness are two different things</h3>
        <table>
          <thead><tr><th>Badge</th><th>Meaning</th></tr></thead>
          <tbody>
            <tr><td><strong>Verified</strong></td><td>Read from the registrar's own published price list during a sync run.</td></tr>
            <tr><td><strong>Snapshot</strong></td><td>From an openly licensed dated dataset, accurate as of that dataset's observation date.</td></tr>
            <tr><td><strong>Modelled</strong></td><td>Derived from a documented pricing policy rather than a published price list.</td></tr>
            <tr><td><strong>Unverified</strong></td><td>No trustworthy observation date, or flagged as placeholder data upstream.</td></tr>
            <tr><td><strong>Recently verified</strong></td><td>Evidence is at most 7 days old. Only first-party reads can earn this label.</td></tr>
            <tr><td><strong>Verification not recent</strong></td><td>Evidence is 8–30 days old.</td></tr>
            <tr><td><strong>Stale</strong></td><td>Evidence is more than 30 days old — a historical reference, not a current quote.</td></tr>
          </tbody>
        </table>
        <p>
          When two sources disagree about the same registrar and extension, the better-verified copy
          wins — <em>before</em> age is considered. A snapshot downloaded this morning cannot displace
          a first-party read from three weeks ago.
        </p>

        <h3>Pricing data pipeline</h3>
        <ol>
          <li><strong>Daily fetch</strong> — GitHub Actions runs <code>npm run sync:prices</code>.</li>
          <li><strong>Validation</strong> — rows are rejected for unknown TLDs (anything not in the IANA catalog), invalid or out-of-range prices, missing USD currency, invalid URLs, duplicates, and — critically — a "verified" claim with no verification date behind it.</li>
          <li><strong>Failure guards</strong> — a source that errors, returns zero valid rows, or shrinks by more than 50% keeps its previous rows untouched; if every source fails, <code>data/prices.json</code> is left byte-for-byte unchanged and the run fails.</li>
          <li><strong>Merge</strong> — one offer per registrar+TLD, ranked by verification tier, then evidence age, then source priority.</li>
          <li><strong>Freshness</strong> — recomputed from each offer's evidence date on every build, so a rebuild can never re-date an old price.</li>
          <li><strong>Report</strong> — every run writes <code>data/price-sync-report.json</code> (machine-readable) and <code>data/price-sync-report.md</code> (human-readable), stating how many published prices are first-party reads, how many are snapshots, and the oldest evidence in the dataset.</li>
          <li><strong>Commit only on change</strong> — if the dataset is unchanged, nothing is committed, so no rebuild is triggered.</li>
        </ol>
      </section>

      <section>
        <h2>Supplemental sources (verified per-TLD)</h2>
        <ul>
          <li><strong>Registry websites</strong> — Official registration policy pages (linked from IANA's "URL for registration services").</li>
          <li><strong>ICANN Registry Agreements</strong> — For gTLDs, the base agreement and any amendments.</li>
          <li><strong>IANA Reports</strong> — Delegation/redelegation reports linked from per-TLD pages.</li>
        </ul>
        <p>Editorial notes (registration restrictions, practical guidance) are researched from registry policies and cited explicitly. Unverified claims are marked as such.</p>
      </section>

      <section>
        <h2>Data processing pipeline</h2>
        <ol>
          <li><strong>Weekly sync</strong> — Automated script fetches both IANA sources every Monday (GitHub Actions).</li>
          <li><strong>Validation</strong> — Parsers reject malformed data, duplicates, or implausibly small datasets.</li>
          <li><strong>Merge</strong> — Delegated list (source of truth for "active" TLDs) joined with Root Zone DB rows (type, manager).</li>
          <li><strong>Detail enrichment</strong> — For TLDs without a manager in the DB table, the per-TLD delegation page is fetched for WHOIS/RDAP/URL/dates.</li>
          <li><strong>Normalisation</strong> — Types mapped to canonical values; IDN labels decoded to Unicode.</li>
          <li><strong>Change detection</strong> — Added/removed TLDs logged; meta.json updated with timestamps and counts.</li>
          <li><strong>Build</strong> — Astro SSG generates static HTML for all pages from the JSON dataset.</li>
        </ol>
      </section>

      <section>
        <h2>Data quality levels</h2>
        <table>
          <thead><tr><th>Level</th><th>Meaning</th></tr></thead>
          <tbody>
            <tr><td><strong>Verified</strong></td><td>Type, manager, and delegation status confirmed against IANA sources.</td></tr>
            <tr><td><strong>Verified + Editorial</strong></td><td>Verified + human-reviewed editorial profile (description, restrictions, citations).</td></tr>
            <tr><td><strong>Incomplete</strong></td><td>Missing manager info (IANA shows "Not assigned") and no verified detail page data.</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Known upstream change: IANA's 2026 page redesign</h2>
        <p>
          IANA redesigned both the Root Zone Database index page and the individual delegation
          records during 2026. Two things changed that affect this site:
        </p>
        <ol>
          <li>
            <strong>Type taxonomy.</strong> The index page previously published six type values
            (generic, generic-restricted, country-code, sponsored, infrastructure, test). It now
            publishes three: <em>Generic</em>, <em>Country Code</em> and <em>Special Use</em>. As a
            result <code>.gov</code>, <code>.edu</code>, <code>.museum</code>, <code>.aero</code>,
            <code>.post</code>, <code>.biz</code>, <code>.name</code> and <code>.pro</code> now appear
            as Generic, and <code>.arpa</code> as Special Use. We follow what IANA publishes and
            record the change here instead of inferring the old labels.
          </li>
          <li>
            <strong>Delegation status column.</strong> The index page now publishes a status per
            TLD (<em>Active</em>, <em>Retired</em>, <em>Reserved</em>, <em>Eligible</em>). The sync
            script cross-checks the count of <em>Active</em> rows against the authoritative delegated
            list and logs a warning if they diverge, but the delegated list still decides which
            records exist.
          </li>
        </ol>
        <p>
          The parsers in <code>src/lib/iana.ts</code> support both the legacy and the current layouts,
          so a re-sync is stable regardless of which version IANA serves.
        </p>
      </section>

      <section>
        <h2>Update frequency</h2>
        <ul>
          <li><strong>TLD metadata: automated weekly</strong> — Every Monday ~06:30 UTC (after IANA's typical update window).</li>
          <li><strong>Pricing: automated daily</strong> — GitHub Actions fetches all pricing sources every day; commits only when the dataset actually changed.</li>
          <li><strong>Manual trigger</strong> — Available via GitHub Actions workflow dispatch for both pipelines.</li>
          <li><strong>Emergency</strong> — If a major delegation change occurs, we can re-run immediately.</li>
        </ul>
      </section>

      <section>
        <h2>What we do NOT do</h2>
        <ul>
          <li>We do <strong>not</strong> bypass authentication, anti-bot controls, or terms-of-use restrictions on any registrar's website. Where we read a registrar's published price list we use a plain HTTP GET with an identifying user agent, at a low rate, and only on paths its <code>robots.txt</code> allows.</li>
          <li>We do <strong>not</strong> scrape quotes, carts, or availability checks for individual domain names.</li>
          <li>We do <strong>not</strong> guess prices: if a source doesn't publish a figure, we show "Price unavailable".</li>
          <li>We do <strong>not</strong> convert currencies or infer a price from another extension's price.</li>
          <li>We do <strong>not</strong> let affiliate relationships (none exist today) influence which offer is labelled cheapest — rankings use published prices only.</li>
          <li>We do <strong>not</strong> guess or infer registration rules — only cite verified sources.</li>
          <li>We do <strong>not</strong> track domain ownership, WHOIS history, or aftermarket data.</li>
        </ul>
      </section>

      <section>
        <h2>Licensing & attribution</h2>
        <p>IANA data is public domain / freely redistributable per <a href="https://www.iana.org/iana-legal" target="_blank" rel="noopener">IANA's legal notices</a>. Our compiled dataset, editorial content, and code are proprietary. You may link to our pages freely. For bulk data use, <a href="/contact/">contact us</a>.</p>
        <p>Third-party pricing datasets are reused under their own licences, with attribution shown here and on every detail page:</p>
        <ul>
          <li><strong>Best Domain Registrars</strong> — CC BY 4.0. <em>"Price data by Best Domain Registrars" — <a href="https://www.best-domain-registrars.com" target="_blank" rel="noopener">best-domain-registrars.com</a></em>.</li>
          <li><strong>Pikkly</strong> — CC BY 4.0. <em>"Price data by Pikkly" — <a href="https://pikkly.dev" target="_blank" rel="noopener">pikkly.dev</a></em>.</li>
          <li><strong>Open Domain Data</strong> — CC BY 4.0. <em>Open Domain Data (2026). tld_pricing, <a href="https://www.opendomaindata.org/datasets/tld-pricing" target="_blank" rel="noopener">opendomaindata.org</a></em>.</li>
          <li><strong>Porkbun, Dynadot, Gandi, Hover, IONOS</strong> — their own published price lists, read as public pages and used as factual price references.</li>
        </ul>
      </section>

      <section>
        <h2>Verification & corrections</h2>
        <p>If you spot an error, please <a href="/contact/">contact us</a> with the TLD, the issue, and a source. We investigate and correct within one sync cycle.</p>
      </section>
    </article>
  </div>
</Layout>