---
// index.astro — Homepage. Price comparison is the main feature; the
// TLD catalogue sections below remain as supporting content.
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import PriceComparisonTable from '../components/PriceComparisonTable.astro';
import { siteConfig, popularTlds, navLinks } from '../config/site.js';
import { loadRecord, loadAllRecords, getGeneratedAt } from '../lib/store.js';
import { buildComparisonRows, getPriceStats } from '../lib/pricing.js';

const allRecords = await loadAllRecords();
const popularRecords = [];
for (const suffix of popularTlds) {
  const rec = await loadRecord(`.${suffix}`);
  if (rec) popularRecords.push(rec);
}

const typeCounts: Record<string, number> = {};
for (const r of allRecords) {
  const t = r.normalized_type ?? 'unknown';
  typeCounts[t] = (typeCounts[t] || 0) + 1;
}

const generatedAt = await getGeneratedAt();
const lastSync = generatedAt ? new Date(generatedAt).toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' }) : 'Unknown';

// Pricing: cheapest-per-TLD rows for the comparison table, plus the list of
// catalog TLDs with no price data (search tells the visitor honestly).
const priceRows = await buildComparisonRows();
const priceStats = await getPriceStats();
const pricedTlds = new Set(priceRows.map(r => r.tld));
const unpricedTlds = allRecords
  .map(r => r.ascii_name)
  .filter(name => !pricedTlds.has(name));
---

<Layout title="Domain Price Comparison — Cheapest Registrar for Every TLD" description={siteConfig.description}>
  <Hero />

  <PriceComparisonTable
    rows={priceRows}
    unpricedTlds={unpricedTlds}
    generatedAt={priceStats?.generatedAt ?? null}
    tlids={priceStats?.tlids ?? 0}
    registrars={priceStats?.registrars ?? 0}
  />

  <section class="py-16 bg-white" aria-labelledby="popular-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12">
        <h2 id="popular-heading" class="text-2xl sm:text-3xl font-bold text-ink-900">Popular TLDs</h2>
        <p class="mt-2 text-ink-600 max-w-2xl mx-auto">Commonly used extensions — all verified against IANA data.</p>
      </header>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {popularRecords.map(rec => (
          <article class="bg-white border border-ink-200 rounded-xl p-5 hover:border-brand-300 hover:shadow-md transition-all duration-200">
            <header class="flex items-baseline gap-2 mb-3">
              <a href={`/tld/${rec.ascii_name}/`} class="text-xl font-mono font-semibold text-ink-900 hover:text-brand-600">{rec.suffix}</a>
              {rec.is_idn && <span class="px-2 py-0.5 text-xs font-medium bg-brand-100 text-brand-700 rounded-full">IDN</span>}
            </header>
            <dl class="space-y-2 text-sm">
              <div class="flex gap-2"><dt class="text-ink-500 w-20 shrink-0">Type</dt><dd class="text-ink-900">{rec.normalized_type?.replace(/-/g, ' ') ?? 'Unknown'}</dd></div>
              <div class="flex gap-2"><dt class="text-ink-500 w-20 shrink-0">Manager</dt><dd class="text-ink-900 truncate-suffix">{rec.manager_name ?? 'Not assigned'}</dd></div>
            </dl>
            <footer class="mt-4 pt-3 border-t border-ink-100">
              <a href={`/tld/${rec.ascii_name}/`} class="text-sm font-medium text-brand-600 hover:text-brand-700">View details →</a>
            </footer>
          </article>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-ink-500">
        <a href="/tlds/" class="font-medium text-brand-600 hover:text-brand-700">Browse all {allRecords.length} TLDs →</a>
      </p>
    </div>
  </section>

  <section class="py-16 bg-ink-50" aria-labelledby="categories-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12">
        <h2 id="categories-heading" class="text-2xl sm:text-3xl font-bold text-ink-900">Browse by Category</h2>
        <p class="mt-2 text-ink-600 max-w-2xl mx-auto">TLDs are classified by IANA based on their governance and purpose.</p>
      </header>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/category/generic/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">Generic TLDs</h3>
          <p class="mt-2 text-ink-600">{typeCounts.generic ?? 0} extensions</p>
          <p class="mt-3 text-sm text-ink-500">.com, .org, .net, .dev, .app — plus .gov, .edu and .museum, which IANA now also classifies as generic.</p>
        </a>
        <a href="/category/country-code/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">Country-code TLDs</h3>
          <p class="mt-2 text-ink-600">{typeCounts['country-code'] ?? 0} extensions</p>
          <p class="mt-3 text-sm text-ink-500">Two-letter codes for countries and territories: .uk, .de, .jp, .ai, .io.</p>
        </a>
        <a href="/category/internationalized/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">Internationalized TLDs</h3>
          <p class="mt-2 text-ink-600">{allRecords.filter(r => r.is_idn).length} extensions</p>
          <p class="mt-3 text-sm text-ink-500">Non-Latin script TLDs like .中国, .рф, .السعودية.</p>
        </a>
        <a href="/category/special-use/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">Special-use TLDs</h3>
          <p class="mt-2 text-ink-600">{typeCounts['special-use'] ?? 0} extension</p>
          <p class="mt-3 text-sm text-ink-500">IANA classifies .arpa as "Special Use" — technical infrastructure, not for public registration.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white" aria-labelledby="tools-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12">
        <h2 id="tools-heading" class="text-2xl sm:text-3xl font-bold text-ink-900">Tools</h2>
        <p class="mt-2 text-ink-600 max-w-2xl mx-auto">Practical utilities for working with TLDs.</p>
      </header>
      <div class="grid gap-6 lg:grid-cols-3">
        <a href="/tools/compare/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">TLD Comparison</h3>
          <p class="mt-2 text-ink-600">Compare types, managers, and technical details side by side.</p>
        </a>
        <a href="/tlds/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">Search & Filter</h3>
          <p class="mt-2 text-ink-600">Find TLDs by name, registry, type, or first letter instantly.</p>
        </a>
        <a href="/guides/" class="group bg-white border border-ink-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-md transition-all duration-200">
          <h3 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">Domain Guides</h3>
          <p class="mt-2 text-ink-600">Learn how domains work, how to choose, and what to watch for.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 bg-ink-50" aria-labelledby="stats-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12">
        <h2 id="stats-heading" class="text-2xl sm:text-3xl font-bold text-ink-900">Data at a Glance</h2>
      </header>
      <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl mx-auto">
        <div class="text-center">
          <dt class="text-4xl sm:text-5xl font-bold text-brand-600">{allRecords.length}</dt>
          <dd class="text-ink-600">Total TLDs</dd>
        </div>
        <div class="text-center">
          <dt class="text-4xl sm:text-5xl font-bold text-brand-600">{priceStats?.tlids ?? 0}</dt>
          <dd class="text-ink-600">Extensions with price data</dd>
        </div>
        <div class="text-center">
          <dt class="text-4xl sm:text-5xl font-bold text-brand-600">{priceStats?.registrars ?? 0}</dt>
          <dd class="text-ink-600">Registrars tracked</dd>
        </div>
        <div class="text-center">
          <dt class="text-4xl sm:text-5xl font-bold text-brand-600">{Object.keys(typeCounts).length}</dt>
          <dd class="text-ink-600">Type categories</dd>
        </div>
        <div class="text-center">
          <dt class="text-4xl sm:text-5xl font-bold text-brand-600">{allRecords.filter(r => r.is_idn).length}</dt>
          <dd class="text-ink-600">IDN TLDs</dd>
        </div>
        <div class="text-center">
          <dt class="text-4xl sm:text-5xl font-bold text-brand-600">{allRecords.filter(r => r.has_editorial).length}</dt>
          <dd class="text-ink-600">Editorial profiles</dd>
        </div>
      </dl>
      <p class="mt-8 text-center text-sm text-ink-500">
        TLD data last synced from IANA on <time datetime={generatedAt ?? ''}>{lastSync}</time>.
        {priceStats?.generatedAt && (
          <> Price data last updated{' '}
            <time datetime={priceStats.generatedAt}>
              {new Date(priceStats.generatedAt).toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
            </time>.
          </>
        )}
        <a href="/data-sources/" class="ml-2 underline hover:text-brand-600">Learn more →</a>
      </p>
    </div>
  </section>

  <section class="py-16 bg-white" aria-labelledby="guides-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="flex items-center justify-between mb-8">
        <h2 id="guides-heading" class="text-2xl sm:text-3xl font-bold text-ink-900">Latest Guides</h2>
        <a href="/guides/" class="text-sm font-medium text-brand-600 hover:text-brand-700">View all →</a>
      </header>
      <div class="grid gap-6 md:grid-cols-3">
        <article class="bg-ink-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-ink-900"><a href="/guides/what-is-a-top-level-domain/" class="hover:text-brand-600">What Is a Top-Level Domain?</a></h3>
          <p class="mt-2 text-ink-600 text-sm">The hierarchy of domain names and where TLDs fit in the DNS.</p>
        </article>
        <article class="bg-ink-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-ink-900"><a href="/guides/registry-vs-registrar/" class="hover:text-brand-600">Registry vs Registrar</a></h3>
          <p class="mt-2 text-ink-600 text-sm">Understanding the difference between the operator and the seller.</p>
        </article>
        <article class="bg-ink-50 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-ink-900"><a href="/guides/how-to-choose-a-domain-extension/" class="hover:text-brand-600">How to Choose a Domain Extension</a></h3>
          <p class="mt-2 text-ink-600 text-sm">Practical framework for picking the right TLD for your project.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-16 bg-ink-50" aria-labelledby="about-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="about-heading" class="text-2xl sm:text-3xl font-bold text-ink-900 text-center mb-8">About This Site</h2>
      <div class="max-w-3xl mx-auto space-y-6 text-ink-700">
        <p>{siteConfig.name} is an independent price-comparison and reference site for top-level domains. We compare registrar registration, renewal and transfer prices from published price lists and openly-licensed datasets, aggregate public data from the <a href="https://www.iana.org/domains/root/db" class="underline hover:text-brand-600">IANA Root Zone Database</a> and the <a href="https://data.iana.org/TLD/tlds-alpha-by-domain.txt" class="underline hover:text-brand-600">IANA delegated list</a>, add human-reviewed editorial notes, and provide practical tools and guides.</p>
        <p>We are not affiliated with ICANN, any registry, or any registrar. Rankings are based on published prices alone — never on commission. No tracking, no cookies, no third-party scripts — just clean, fast, verifiable information.</p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/about/" class="px-4 py-2 text-sm font-medium text-brand-600 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100">About us</a>
          <a href="/contact/" class="px-4 py-2 text-sm font-medium text-brand-600 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100">Contact</a>
          <a href="/data-sources/" class="px-4 py-2 text-sm font-medium text-brand-600 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100">Data sources</a>
          <a href="/adsense-readiness/" class="px-4 py-2 text-sm font-medium text-brand-600 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100">Quality checklist</a>
        </div>
      </div>
    </div>
  </section>
</Layout>