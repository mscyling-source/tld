---
// privacy/index.astro
import Layout from '../../components/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { siteConfig } from '../../config/site.js';
---

<Layout
  title="Privacy Policy"
  description="TLD Directory's privacy policy: what data we collect (nothing), how we use it, and your rights."
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Privacy Policy' }
    ]} />

    <article class="prose prose-ink max-w-none">
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-ink-900">Privacy Policy</h1>
        <p class="mt-3 text-ink-600">Last updated: October 2026</p>
      </header>

      <section>
        <h2>Summary</h2>
        <p><strong>We collect no personal data.</strong> No cookies, no analytics, no tracking, no third-party scripts. This policy explains what that means in practice.</p>
      </section>

      <section>
        <h2>Data we collect</h2>
        <p><strong>None.</strong> We do not use:</p>
        <ul>
          <li>Cookies (session, persistent, or third-party)</li>
          <li>LocalStorage / IndexedDB / any client-side storage</li>
          <li>Analytics (Google Analytics, Matomo, Plausible, etc.)</li>
          <li>Tracking pixels or beacons</li>
          <li>Fingerprinting scripts</li>
          <li>Contact forms (we use mailto: links)</li>
          <li>Newsletter signups</li>
          <li>User accounts or authentication</li>
        </ul>
      </section>

      <section>
        <h2>Server logs</h2>
        <p>Our hosting provider (Cloudflare Pages) may log standard HTTP request metadata (IP address, user agent, requested path, timestamp, referrer) for security and operational purposes. We do not access, analyse, or retain these logs for analytics. Cloudflare's privacy policy applies.</p>
      </section>

      <section>
        <h2>Third-party services</h2>
        <p><strong>None.</strong> This site loads no external scripts, fonts, images, or stylesheets. All assets are self-hosted. No CDN for dynamic content. No social media widgets.</p>
      </section>

      <section>
        <h2>Email contact</h2>
        <p>If you email us, your message (including your email address) is stored in our email provider's systems (standard email retention). We use it only to reply. We do not add you to any list.</p>
      </section>

      <section>
        <h2>Your rights</h2>
        <p>Since we hold no personal data about you, there is nothing to access, rectify, erase, or port. If you believe we have data about you, <a href="/contact/">contact us</a>.</p>
      </section>

      <section>
        <h2>Changes to this policy</h2>
        <p>If we ever add analytics, ads, or third-party services, we will update this policy <strong>before</strong> the change takes effect and add a prominent notice on the site.</p>
      </section>

      <section>
        <h2>Contact</h2>
        <p>Privacy questions: <a href="mailto:{siteConfig.contactEmail}">{siteConfig.contactEmail}</a></p>
      </section>

      <footer class="mt-12 pt-8 border-t border-ink-200">
        <p class="text-sm text-ink-500">
          {siteConfig.name} · <a href="/terms/" class="underline hover:text-brand-600">Terms of use</a> · <a href="/data-sources/" class="underline hover:text-brand-600">Data sources</a>
        </p>
      </footer>
    </article>
  </div>
</Layout>